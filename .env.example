EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEV_SESSION=true
# Public client credentials only. NEVER put a service_role/secret key in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
